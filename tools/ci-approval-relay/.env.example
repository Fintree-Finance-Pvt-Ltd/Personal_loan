# Port this service listens on. Put Nginx in front of it (see README.md).
PORT=4100

# Your Jenkins base URL (same one the Jenkins UI is reached at).
JENKINS_BASE_URL=https://ci.yourdomain.com

# A Jenkins user + API token (Jenkins -> your user icon -> Configure -> API Token ->
# Add new Token) used server-side to call Jenkins' REST API on the approver's behalf.
# Never exposed to the browser or the email.
JENKINS_API_USER=
JENKINS_API_TOKEN=

# Shared secret only Jenkins and this service know, authenticating the Jenkinsfile's
# POST /register call. Generate with: openssl rand -hex 32
RELAY_SHARED_SECRET=

# How long an approval link stays valid before it expires (minutes). 4320 = 3 days.
TOKEN_TTL_MINUTES=4320
