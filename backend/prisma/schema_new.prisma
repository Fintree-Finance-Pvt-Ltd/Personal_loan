  INTEGER
  DECIMAL
  STRING
  STRING_ARRAY
}

enum PolicyRuleOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
