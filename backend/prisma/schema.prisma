  bankAccountHolderName String?   @map("bank_account_holder_name") @db.VarChar(200)
  bankAccountType       String?   @map("bank_account_type") @db.VarChar(30)
  bankAccountMasked     String?   @map("bank_account_masked") @db.VarChar(30)
  bankIfsc              String?   @map("bank_ifsc") @db.VarChar(11)
  bankName              String?   @map("bank_name") @db.VarChar(100)
  bankProviderReference String?   @map("bank_provider_reference") @db.VarChar(255)
  bankNameMatchScore    Decimal?  @map("bank_name_match_score") @db.Decimal(5, 2)
  bankVerifiedAt        DateTime? @map("bank_verified_at") @db.DateTime(0)

  // ── KFS ───────────────────────────────────────────────────────────────
  kfsAccepted    Boolean   @default(false) @map("kfs_accepted")
  kfsVersion     String?   @map("kfs_version") @db.VarChar(20)
  kfsDocumentId  String?   @map("kfs_document_id") @db.VarChar(100)
  kfsGeneratedAt DateTime? @map("kfs_generated_at") @db.DateTime(0)
  kfsViewedAt    DateTime? @map("kfs_viewed_at") @db.DateTime(0)
  kfsAcceptedAt  DateTime? @map("kfs_accepted_at") @db.DateTime(0)
  kfsConsentText String?   @map("kfs_consent_text") @db.Text
  kfsIpAddress   String?   @map("kfs_ip_address") @db.VarChar(45)
  kfsUserAgent   String?   @map("kfs_user_agent") @db.VarChar(500)

  // ── eMandate ──────────────────────────────────────────────────────────
  mandateCompleted   Boolean   @default(false) @map("mandate_completed")
  mandateStatus      String?   @map("mandate_status") @db.VarChar(30)
  mandateProviderRef String?   @map("mandate_provider_ref") @db.VarChar(255)
  mandateInitiatedAt DateTime? @map("mandate_initiated_at") @db.DateTime(0)
  mandateCompletedAt DateTime? @map("mandate_completed_at") @db.DateTime(0)

  // ── eSign ─────────────────────────────────────────────────────────────
  esignCompleted     Boolean   @default(false) @map("esign_completed")
