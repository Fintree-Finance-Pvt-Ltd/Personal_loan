  currentAddrLine2          String?   @map("current_addr_line2") @db.VarChar(500)
  currentAddrLandmark       String?   @map("current_addr_landmark") @db.VarChar(200)
  currentAddrLocality       String?   @map("current_addr_locality") @db.VarChar(200)
  currentAddrDistrict       String?   @map("current_addr_district") @db.VarChar(100)
  currentAddrCity           String?   @map("current_addr_city") @db.VarChar(100)
  currentAddrState          String?   @map("current_addr_state") @db.VarChar(100)
  currentAddrCountry        String?   @default("India") @map("current_addr_country") @db.VarChar(50)
  currentAddrPincode        String?   @map("current_addr_pincode") @db.VarChar(6)
  currentAddrResidenceSince String?   @map("current_addr_residence_since") @db.VarChar(20)
  currentAddrProofType      String?   @map("current_addr_proof_type") @db.VarChar(50)
  currentAddrDocumentId     String?   @map("current_addr_document_id") @db.VarChar(100)
