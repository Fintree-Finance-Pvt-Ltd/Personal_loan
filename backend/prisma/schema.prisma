model MlmAllocationRouteState {
  id String @id @default(cuid())

  mlmPolicyVersionId String
  routeId            String @unique

  currentWeight             Decimal   @default(0) @db.Decimal(12, 4)
  allocatedApplicationCount Int       @default(0)
