  markedCompleteAt     DateTime @db.DateTime(0)
  createdAt            DateTime @default(now()) @db.DateTime(0)

  application PartnerApplication @relation(fields: [partnerApplicationId], references: [id], onDelete: Cascade)

  @@map("partner_application_profile_snapshots")
}

enum PartnerDecisionType {
  PRE_APPROVAL
  FINAL_APPROVAL
}

enum PartnerDecisionOutcome {
  APPROVED
  REJECTED
  PENDING
}

model PartnerApplicationDecision {
  id                   String                 @id @default(cuid())
  partnerApplicationId String
  decisionType         PartnerDecisionType
  outcome              PartnerDecisionOutcome
  decisionReference    String                 @db.VarChar(150)
  decisionAt           DateTime               @db.DateTime(0)
  reasonCode           String?                @db.VarChar(100)
  coolingOffDays       Int?
  nextStatusCheckAt    DateTime?              @db.DateTime(0)
  offerData            String?                @db.LongText
  createdAt            DateTime               @default(now()) @db.DateTime(0)

  application PartnerApplication @relation(fields: [partnerApplicationId], references: [id], onDelete: Cascade)

  @@unique([partnerApplicationId, decisionType])
  @@map("partner_application_decisions")
}

model PartnerApplicationOnboardingSnapshot {
  id                   String   @id @default(cuid())
  partnerApplicationId String   @unique
  onboardingData       String   @db.LongText
  markedCompleteAt     DateTime @db.DateTime(0)
  createdAt            DateTime @default(now()) @db.DateTime(0)

  application PartnerApplication @relation(fields: [partnerApplicationId], references: [id], onDelete: Cascade)

  @@map("partner_application_onboarding_snapshots")
}

model PartnerApplicationMandate {
  id                   String   @id @default(cuid())
  partnerApplicationId String   @unique
  provider             String   @db.VarChar(100)
  mandateReference     String   @db.VarChar(150)
  umrn                 String   @db.VarChar(50)
  status               String   @db.VarChar(50)
  authorizedAt         DateTime @db.DateTime(0)
  createdAt            DateTime @default(now()) @db.DateTime(0)

  application PartnerApplication @relation(fields: [partnerApplicationId], references: [id], onDelete: Cascade)

  @@map("partner_application_mandates")
}

enum PartnerDisbursementStatus {
  PENDING
  DISBURSED
  FAILED
}

model PartnerApplicationDisbursement {
  id                    String                    @id @default(cuid())
  partnerApplicationId  String
  disbursementReference String                    @unique @db.VarChar(150)
  status                PartnerDisbursementStatus @default(PENDING)
  requestedAt           DateTime                  @db.DateTime(0)
  processedAt           DateTime?                 @db.DateTime(0)
  failureCode           String?                   @db.VarChar(100)
  createdAt             DateTime                  @default(now()) @db.DateTime(0)
  updatedAt             DateTime                  @updatedAt @db.DateTime(0)

  application PartnerApplication @relation(fields: [partnerApplicationId], references: [id], onDelete: Cascade)

  @@map("partner_application_disbursements")
}

enum PartnerWebhookStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  DEAD_LETTER
}

model PartnerWebhookOutbox {
  id                   String               @id @default(cuid())
  clientId             String
  partnerApplicationId String?
  eventType            String               @db.VarChar(100)
  payload              String               @db.LongText
  status               PartnerWebhookStatus @default(PENDING)
  attempts             Int                  @default(0)
  nextAttemptAt        DateTime?            @db.DateTime(0)
  lastFailureReason    String?              @db.VarChar(500)
  createdAt            DateTime             @default(now()) @db.DateTime(0)
  updatedAt            DateTime             @updatedAt @db.DateTime(0)

  client      PartnerApiClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application PartnerApplication? @relation(fields: [partnerApplicationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([clientId])
  @@map("partner_webhook_outbox")
}

model PartnerApiAuditLog {
  id                   String   @id @default(cuid())
  clientId             String
  partnerApplicationId String?  @db.VarChar(50)
  endpoint             String   @db.VarChar(200)
  method               String   @db.VarChar(10)
  correlationId        String?  @db.VarChar(100)
  idempotencyKey       String?  @db.VarChar(100)
  requestHash          String?  @db.Char(64)
  responseStatus       Int
  durationMs           Int
  createdAt            DateTime @default(now()) @db.DateTime(0)

  client PartnerApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([correlationId])
  @@map("partner_api_audit_logs")
}

enum LenderDocumentTransferStatus {
  PENDING
  PROCESSING
  ACKNOWLEDGED
  FAILED
  SKIPPED
}

model LenderDocumentTransfer {
  id                      BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  applicationId           BigInt  @map("application_id") @db.UnsignedBigInt
  lenderApplicationLinkId String  @map("lender_application_link_id")
  sourceDocumentId        BigInt  @map("source_document_id") @db.UnsignedBigInt
  documentType            String  @map("document_type") @db.VarChar(50)
  sourceFileSha256        String? @map("source_file_sha256") @db.Char(64)

  sourceDocument    PlCustomerDocument           @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  sourceFileSize    Int?                         @map("source_file_size")
  sourceMimeType    String?                      @map("source_mime_type") @db.VarChar(100)
  partnerDocumentId String?                      @map("partner_document_id") @db.VarChar(100)
  transferStatus    LenderDocumentTransferStatus @default(PENDING) @map("transfer_status")
  providerStatus    String?                      @map("provider_status") @db.VarChar(50)
  idempotencyKey    String                       @unique @map("idempotency_key") @db.VarChar(100)
  acknowledgedAt    DateTime?                    @map("acknowledged_at") @db.DateTime(0)
  lastErrorCode     String?                      @map("last_error_code") @db.VarChar(100)
  lastErrorMessage  String?                      @map("last_error_message") @db.Text
  createdAt         DateTime                     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.DateTime(0)

  lenderApplicationLink LenderApplicationLink     @relation(fields: [lenderApplicationLinkId], references: [id], onDelete: Cascade)
  outboxEvents          LenderIntegrationOutbox[]

  @@unique([lenderApplicationLinkId, sourceDocumentId, documentType])
  @@index([applicationId])
  @@index([transferStatus])
  @@map("lender_document_transfers")
}

model CustomerAccountAggregatorRequest {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  customerId    BigInt  @map("customer_id") @db.UnsignedBigInt
  applicationId BigInt? @map("application_id") @db.UnsignedBigInt

  lan String @db.VarChar(50)

  provider String @default("UNAPORT") @db.VarChar(30)

  trackingId String @unique(map: "uk_pl_aa_tracking_id") @map("tracking_id") @db.VarChar(150)

  consentId     String? @map("consent_id") @db.VarChar(255)
  consentHandle String? @map("consent_handle") @db.VarChar(255)
  sessionId     String? @map("session_id") @db.VarChar(255)

  status String @db.VarChar(50)

  consentStatus String? @map("consent_status") @db.VarChar(50)
  dataStatus    String? @map("data_status") @db.VarChar(50)

  initiatedAt DateTime? @map("initiated_at") @db.DateTime(0)
  consentedAt DateTime? @map("consented_at") @db.DateTime(0)
  dataReadyAt DateTime? @map("data_ready_at") @db.DateTime(0)
  completedAt DateTime? @map("completed_at") @db.DateTime(0)
  failedAt    DateTime? @map("failed_at") @db.DateTime(0)

  providerRequestEncrypted  String? @map("provider_request_encrypted") @db.LongText
  providerResponseEncrypted String? @map("provider_response_encrypted") @db.LongText

  failureCode   String? @map("failure_code") @db.VarChar(100)
  failureReason String? @map("failure_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  bankData CustomerBankAccountData[]

  @@index([customerId], map: "idx_pl_aa_req_customer")
  @@index([applicationId], map: "idx_pl_aa_req_application")
  @@index([lan], map: "idx_pl_aa_req_lan")
  @@index([sessionId], map: "idx_pl_aa_req_session")
  @@index([status], map: "idx_pl_aa_req_status")
  @@map("customer_account_aggregator_requests")
}

model CustomerBankAccountData {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  requestId     BigInt                           @map("request_id") @db.UnsignedBigInt
  request       CustomerAccountAggregatorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customerId    BigInt                           @map("customer_id") @db.UnsignedBigInt
  applicationId BigInt?                          @map("application_id") @db.UnsignedBigInt
  lan           String                           @db.VarChar(50)
  provider      String                           @default("UNAPORT") @db.VarChar(30)
  sessionId     String?                          @map("session_id") @db.VarChar(255)

  fipId                  String?   @map("fip_id") @db.VarChar(100)
  fipName                String?   @map("fip_name") @db.VarChar(150)
  accountType            String?   @map("account_type") @db.VarChar(50)
  accountNumberMasked    String?   @map("account_number_masked") @db.VarChar(50)
  accountNumberEncrypted String?   @map("account_number_encrypted") @db.Text
  accountHolderName      String?   @map("account_holder_name") @db.VarChar(200)
  ifscCode               String?   @map("ifsc_code") @db.VarChar(20)
  branchName             String?   @map("branch_name") @db.VarChar(150)
  currency               String?   @default("INR") @db.VarChar(10)
  currentBalance         Decimal?  @map("current_balance") @db.Decimal(15, 2)
  availableBalance       Decimal?  @map("available_balance") @db.Decimal(15, 2)
  summaryDate            DateTime? @map("summary_date") @db.DateTime(0)
  fromDate               DateTime? @map("from_date") @db.DateTime(0)
  toDate                 DateTime? @map("to_date") @db.DateTime(0)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  transactions CustomerBankTransaction[]

  @@index([customerId], map: "idx_pl_bank_data_customer")
  @@index([applicationId], map: "idx_pl_bank_data_app")
  @@index([lan], map: "idx_pl_bank_data_lan")
  @@map("customer_bank_account_data")
}

model CustomerBankTransaction {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  bankDataId BigInt                  @map("bank_data_id") @db.UnsignedBigInt
  bankData   CustomerBankAccountData @relation(fields: [bankDataId], references: [id], onDelete: Cascade)

  txnId           String?   @map("txn_id") @db.VarChar(150)
  txnDate         DateTime  @map("txn_date") @db.DateTime(0)
  valueDate       DateTime? @map("value_date") @db.DateTime(0)
  txnType         String    @map("txn_type") @db.VarChar(20)
  amount          Decimal   @db.Decimal(15, 2)
  balance         Decimal?  @db.Decimal(15, 2)
  narration       String?   @db.Text
  mode            String?   @db.VarChar(50)
  referenceNumber String?   @map("reference_number") @db.VarChar(150)
  transactionHash String    @map("transaction_hash") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([bankDataId, transactionHash], map: "uk_bank_txn_dedup")
  @@index([bankDataId], map: "idx_pl_bank_txn_data")
  @@index([txnDate], map: "idx_pl_bank_txn_date")
  @@map("customer_bank_transactions")
}

