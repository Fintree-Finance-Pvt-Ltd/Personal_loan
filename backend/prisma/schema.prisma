generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  DISABLED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum LoginOutcome {
  SUCCESS
  FAILURE
  LOCKED
  DISABLED
  RATE_LIMITED
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum LenderApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LenderOperationalStatus {
  INACTIVE
  ACTIVE
}

enum LenderIntegrationHealth {
  NOT_CONFIGURED
  HEALTHY
  DEGRADED
  DOWN
}

model User {
  id                String          @id @default(cuid())
  name              String          @db.VarChar(120)
  email             String          @unique @db.VarChar(254)
  passwordHash      String          @db.VarChar(255)
  status            UserStatus      @default(ACTIVE)
  failedLoginCount  Int             @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime        @default(now())
  authVersion       Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  roles             UserRole[]
  assignedRoles     UserRole[]      @relation("RoleAssigner")
  sessions          Session[]
  loginAttempts     LoginAttempt[]
  securityEvents    SecurityEvent[]
  auditLogs         AuditLog[]
  lendersCreated    Lender[]        @relation("LenderCreatedBy")
  lendersUpdated    Lender[]        @relation("LenderUpdatedBy")
  lendersSubmitted  Lender[]        @relation("LenderSubmittedBy")
  lendersApproved   Lender[]        @relation("LenderApprovedBy")
  lendersRejected   Lender[]        @relation("LenderRejectedBy")

  platformProductsCreated PlatformProduct[] @relation("PlatformProductCreatedBy")
  platformProductsUpdated PlatformProduct[] @relation("PlatformProductUpdatedBy")

  productsCreated          LenderProduct[]        @relation("ProductCreatedBy")
  productsUpdated          LenderProduct[]        @relation("ProductUpdatedBy")
  productVersionsCreated   LenderProductVersion[] @relation("ProductVersionCreatedBy")
  productVersionsUpdated   LenderProductVersion[] @relation("ProductVersionUpdatedBy")
  productVersionsSubmitted LenderProductVersion[] @relation("ProductVersionSubmittedBy")
  productVersionsApproved  LenderProductVersion[] @relation("ProductVersionApprovedBy")
  productVersionsRejected  LenderProductVersion[] @relation("ProductVersionRejectedBy")
  productVersionsActivated LenderProductVersion[] @relation("ProductVersionActivatedBy")

  platformPoliciesCreated         PlatformPolicy[]        @relation("PlatformPolicyCreatedBy")
  platformPoliciesUpdated         PlatformPolicy[]        @relation("PlatformPolicyUpdatedBy")
  platformPolicyVersionsCreated   PlatformPolicyVersion[] @relation("PlatformPolicyVersionCreatedBy")
  platformPolicyVersionsUpdated   PlatformPolicyVersion[] @relation("PlatformPolicyVersionUpdatedBy")
  platformPolicyVersionsSubmitted PlatformPolicyVersion[] @relation("PlatformPolicyVersionSubmittedBy")
  platformPolicyVersionsApproved  PlatformPolicyVersion[] @relation("PlatformPolicyVersionApprovedBy")
  platformPolicyVersionsRejected  PlatformPolicyVersion[] @relation("PlatformPolicyVersionRejectedBy")
  platformPolicyVersionsActivated PlatformPolicyVersion[] @relation("PlatformPolicyVersionActivatedBy")
  mlmPoliciesCreated              MlmPolicy[]             @relation("MlmPolicyCreatedBy")
  mlmPoliciesUpdated              MlmPolicy[]             @relation("MlmPolicyUpdatedBy")

  mlmPolicyVersionsCreated   MlmPolicyVersion[] @relation("MlmPolicyVersionCreatedBy")
  mlmPolicyVersionsUpdated   MlmPolicyVersion[] @relation("MlmPolicyVersionUpdatedBy")
  mlmPolicyVersionsSubmitted MlmPolicyVersion[] @relation("MlmPolicyVersionSubmittedBy")
  mlmPolicyVersionsApproved  MlmPolicyVersion[] @relation("MlmPolicyVersionApprovedBy")
  mlmPolicyVersionsRejected  MlmPolicyVersion[] @relation("MlmPolicyVersionRejectedBy")
  mlmPolicyVersionsActivated MlmPolicyVersion[] @relation("MlmPolicyVersionActivatedBy")

  @@index([status])
  @@index([lockedUntil])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(100)
  code        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  status      RoleStatus       @default(ACTIVE)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@index([status])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(80)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model UserRole {
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   User?    @relation("RoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedBy])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id                String          @id @default(cuid())
  userId            String
  createdAt         DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  revokedAt         DateTime?
  revokedReason     String?         @db.VarChar(120)
  ipAddress         String?         @db.VarChar(64)
  userAgent         String?         @db.VarChar(512)
  deviceLabel       String?         @db.VarChar(160)
  requestId         String          @db.VarChar(64)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  securityEvents    SecurityEvent[]

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model RefreshToken {
  id            String         @id @default(cuid())
  sessionId     String
  tokenHash     String         @unique @db.Char(64)
  parentTokenId String?
  issuedAt      DateTime       @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  session       Session        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  parent        RefreshToken?  @relation("TokenRotation", fields: [parentTokenId], references: [id], onDelete: Restrict)
  children      RefreshToken[] @relation("TokenRotation")

  @@index([sessionId, revokedAt])
  @@index([parentTokenId])
  @@index([expiresAt])
}

model LoginAttempt {
  id               String       @id @default(cuid())
  userId           String?
  emailFingerprint String       @db.Char(64)
  maskedEmail      String       @db.VarChar(254)
  outcome          LoginOutcome
  reasonCode       String       @db.VarChar(80)
  ipAddress        String?      @db.VarChar(64)
  userAgent        String?      @db.VarChar(512)
  requestId        String       @db.VarChar(64)
  createdAt        DateTime     @default(now())
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailFingerprint, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
}

model SecurityEvent {
  id        String           @id @default(cuid())
  userId    String?
  sessionId String?
  eventType String           @db.VarChar(80)
  severity  SecuritySeverity
  requestId String           @db.VarChar(64)
  ipAddress String?          @db.VarChar(64)
  userAgent String?          @db.VarChar(512)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  session   Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  actorUserId    String?
  actorRoleCodes Json
  permissionCode String?      @db.VarChar(100)
  module         String       @db.VarChar(80)
  action         String       @db.VarChar(100)
  entityType     String       @db.VarChar(80)
  entityId       String?      @db.VarChar(191)
  outcome        AuditOutcome
  reason         String?      @db.VarChar(255)
  previousValue  Json?
  newValue       Json?
  requestId      String       @db.VarChar(64)
  ipAddress      String?      @db.VarChar(64)
  userAgent      String?      @db.VarChar(512)
  integrityHash  String       @db.Char(64)
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([module, action, createdAt])
  @@index([entityType, entityId])
  @@index([requestId])
}

model Lender {
  id           String  @id @default(cuid())
  legalName    String  @db.VarChar(255)
  displayName  String  @db.VarChar(150)
  code         String  @unique @db.VarChar(30)
  supportEmail String? @db.VarChar(254)
  supportPhone String? @db.VarChar(20)

  approvalStatus    LenderApprovalStatus    @default(DRAFT)
  operationalStatus LenderOperationalStatus @default(INACTIVE)
  integrationHealth LenderIntegrationHealth @default(NOT_CONFIGURED)

  version Int @default(1)

  createdById   String
  updatedById   String
  submittedById String?
  approvedById  String?
  rejectedById  String?

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("LenderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedBy User @relation("LenderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  submittedBy User? @relation("LenderSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  approvedBy User? @relation("LenderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  rejectedBy User? @relation("LenderRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  products               LenderProduct[]
  mlmAllocationRoutes    MlmAllocationRoute[]
  mlmCapacityUsages      MlmCapacityUsage[]
  mlmAllocationDecisions MlmAllocationDecision[]

  @@index([approvalStatus])
  @@index([operationalStatus])
  @@index([integrationHealth])
  @@index([createdById])
  @@index([updatedById])
  @@index([submittedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([approvalStatus, updatedAt])
  @@index([operationalStatus, updatedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum ProductOperationalStatus {
  INACTIVE
  ACTIVE
}

enum ProductVersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ACTIVE
  SUPERSEDED
}

enum RepeatTierScope {
  SAME_LENDER
  PLATFORM_WIDE
}

enum AmountRoundingMethod {
  NONE
  FLOOR
  NEAREST
  CEIL
}

enum CustomerAccountStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum CustomerOnboardingStatus {
  MOBILE_VERIFIED
  BASIC_DETAILS_PENDING
  PAN_VERIFIED
  EMAIL_VERIFIED
  PLATFORM_BRE_PENDING
  PLATFORM_ELIGIBLE
  PLATFORM_INELIGIBLE
  APPLICATION_IN_PROGRESS
  APPLICATION_SUBMITTED
  LENDER_APPROVED
  LENDER_REJECTED
  DISBURSED
}

enum CustomerEligibilityStatus {
  NOT_CHECKED
  ELIGIBLE
  INELIGIBLE
}

enum CustomerGender {
  MALE
  FEMALE
  OTHER
}

enum CustomerResidenceStatus {
  RENTED
  OWNED
  FAMILY_OWNED
  COMPANY_PROVIDED
}

enum CustomerEmploymentType {
  SALARIED
  SELF_EMPLOYED
}

enum CustomerCompanyType {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  PARTNERSHIP
  GOVERNMENT
  OTHER
}

enum CustomerBusinessConstitution {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  OTHER
}

model LenderProduct {
  id                String                   @id @default(cuid())
  lenderId          String
  platformProductId String
  name              String                   @db.VarChar(120)
  code              String                   @db.VarChar(60)
  description       String?                  @db.VarChar(255)
  operationalStatus ProductOperationalStatus @default(INACTIVE)

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lender                 Lender                  @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  platformProduct        PlatformProduct        @relation(fields: [platformProductId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              User                    @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions               LenderProductVersion[]
  mlmAllocationRoutes    MlmAllocationRoute[]
  mlmCapacityUsages      MlmCapacityUsage[]
  mlmAllocationDecisions MlmAllocationDecision[]

  @@unique([lenderId, code])
  
  @@index([platformProductId, operationalStatus])
  @@index([lenderId, operationalStatus])
}

model LenderProductVersion {
  id                        String                    @id @default(cuid())
  productId                 String
  versionNumber             Int
  status                    ProductVersionStatus
  minimumAmount             Decimal                   @db.Decimal(12, 2)
  firstLoanBaseAmount       Decimal                   @db.Decimal(12, 2)
  maximumAmountCap          Decimal                   @db.Decimal(12, 2)
  repeatTierScope           RepeatTierScope           @default(SAME_LENDER)
  roundingMethod            AmountRoundingMethod
  roundingUnit              Decimal?                  @db.Decimal(12, 2)
  interestMethod            InterestCalculationMethod
  annualRoiPercent          Decimal                   @db.Decimal(7, 4)
  processingFeePercent      Decimal                   @db.Decimal(7, 4)
  processingFeeGstPercent   Decimal                   @db.Decimal(5, 2)
  assessmentFeeAmount       Decimal                   @db.Decimal(12, 2)
  assessmentFeeGstPercent   Decimal                   @db.Decimal(5, 2)
  penalChargeAmount         Decimal                   @db.Decimal(12, 2)
  bounceChargeAmount        Decimal                   @db.Decimal(12, 2)
  emiDueDay                 Int
  includeAssessmentFeeInApr Boolean                   @default(false)
  tenureType                TenureType                @default(MONTHS)
  effectiveFrom             DateTime?
  version                   Int                       @default(1)

  createdById     String
  updatedById     String
  submittedById   String?
  approvedById    String?
  rejectedById    String?
  activatedById   String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  activatedAt     DateTime?
  rejectionReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     LenderProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  multipliers LenderOfferMultiplier[]
  tenures     LenderProductTenure[]
  createdBy   User                    @relation("ProductVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                    @relation("ProductVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  submittedBy User?                   @relation("ProductVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy  User?                   @relation("ProductVersionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User?                   @relation("ProductVersionRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  activatedBy User?                   @relation("ProductVersionActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  @@unique([productId, versionNumber])
  @@index([productId, status])
  @@index([status, updatedAt])
}

enum InterestCalculationMethod {
  REDUCING_BALANCE
  FLAT_RATE
}

enum TenureType {
  MONTHS
  DAYS
}

model LenderOfferMultiplier {
  id                    String               @id @default(cuid())
  productVersionId      String
  minimumCompletedLoans Int
  multiplier            Decimal              @db.Decimal(8, 4)
  sortOrder             Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  productVersion        LenderProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)

  @@unique([productVersionId, minimumCompletedLoans])
  @@unique([productVersionId, sortOrder])
  @@index([productVersionId, sortOrder])
}

model LenderProductTenure {
  id               String               @id @default(cuid())
  productVersionId String
  tenure           Int
  sortOrder        Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  productVersion   LenderProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)

  @@unique([productVersionId, tenure])
  @@unique([productVersionId, sortOrder])
  @@index([productVersionId, sortOrder])
}

enum OtpPurpose {
  MOBILE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
  PAYMENT_VERIFICATION
}

enum OtpChannel {
  SMS
  EMAIL
}

model OtpSession {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  customerId BigInt?   @map("customer_id") @db.UnsignedBigInt
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  mobileNumber String? @map("mobile_number") @db.VarChar(15)
  emailId      String? @map("email_id") @db.VarChar(255)

  purpose OtpPurpose @default(MOBILE_VERIFICATION)
  channel OtpChannel

  otpHash String @map("otp_hash") @db.VarChar(255)

  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at") @db.DateTime(0)

  attempts    Int @default(0) @db.UnsignedInt
  maxAttempts Int @default(5) @map("max_attempts") @db.UnsignedInt

  expiresAt  DateTime @map("expires_at") @db.DateTime(0)
  lastSentAt DateTime @map("last_sent_at") @db.DateTime(0)

  resendCount Int @default(0) @map("resend_count") @db.UnsignedInt

  consentGiven Boolean   @default(false) @map("consent_given")
  consentText  String?   @map("consent_text") @db.Text
  consentAt    DateTime? @map("consent_at") @db.DateTime(0)

  invalidatedAt DateTime? @map("invalidated_at") @db.DateTime(0)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([customerId], map: "idx_otp_sessions_customer_id")
  @@index([mobileNumber], map: "idx_otp_sessions_mobile_number")
  @@index([emailId], map: "idx_otp_sessions_email_id")
  @@index([verified], map: "idx_otp_sessions_verified")
  @@index([expiresAt], map: "idx_otp_sessions_expires_at")
  @@index([purpose], map: "idx_otp_sessions_purpose")
  @@index([createdAt], map: "idx_otp_sessions_created_at")
  @@index([mobileNumber, purpose, createdAt], map: "idx_otp_mobile_purpose_created")
  @@index([emailId, purpose, createdAt], map: "idx_otp_email_purpose_created")
  @@map("otp_sessions")
}

model Customer {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  customerCode String @unique @map("customer_code") @db.VarChar(30)

  countryCode      String       @default("+91") @map("country_code") @db.VarChar(5)
  mobileNumber     String       @unique @map("mobile_number") @db.VarChar(15)
  otpSessions      OtpSession[]
  mobileVerified   Boolean      @default(false) @map("mobile_verified")
  mobileVerifiedAt DateTime?    @map("mobile_verified_at") @db.DateTime(0)

  fullName   String? @map("full_name") @db.VarChar(150)
  firstName  String? @map("first_name") @db.VarChar(60)
  middleName String? @map("middle_name") @db.VarChar(60)
  lastName   String? @map("last_name") @db.VarChar(60)
  fatherName String? @map("father_name") @db.VarChar(150)

  panNumber                String?   @unique @map("pan_number") @db.VarChar(10)
  panVerified              Boolean   @default(false) @map("pan_verified")
  panVerifiedAt            DateTime? @map("pan_verified_at") @db.DateTime(0)
  panProviderApplicationId String?   @map("pan_provider_application_id") @db.VarChar(100)
  panHolderType            String?   @map("pan_holder_type") @db.VarChar(100)

  dateOfBirth DateTime?       @map("date_of_birth") @db.Date
  gender      CustomerGender?

  email           String?   @db.VarChar(255)
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(0)

  residentialPincode String?                  @map("residential_pincode") @db.VarChar(6)
  residentialCity    String?                  @map("residential_city") @db.VarChar(100)
  residentialState   String?                  @map("residential_state") @db.VarChar(100)
  workPincode        String?                  @map("work_pincode") @db.VarChar(6)
  residenceStatus    CustomerResidenceStatus? @map("residence_status")

  employmentType CustomerEmploymentType? @map("employment_type")
  companyType    CustomerCompanyType?    @map("company_type")
  companyName    String?                 @map("company_name") @db.VarChar(200)
  designation    String?                 @db.VarChar(150)

  businessName         String?                       @map("business_name") @db.VarChar(200)
  businessConstitution CustomerBusinessConstitution? @map("business_constitution")

  monthlyIncome  Decimal? @map("monthly_income") @db.Decimal(15, 2)
  annualTurnover Decimal? @map("annual_turnover") @db.Decimal(15, 2)

  employmentVintage  String?   @map("employment_vintage") @db.VarChar(50)
  totalExperience    String?   @map("total_experience") @db.VarChar(50)
  salaryMode         String?   @map("salary_mode") @db.VarChar(50)
  businessVintage    String?   @map("business_vintage") @db.VarChar(50)
  kfsLanguage        String?   @default("English") @map("kfs_language") @db.VarChar(50)
  profileCompletedAt DateTime? @map("profile_completed_at") @db.DateTime(0)

  accountStatus     CustomerAccountStatus     @default(ACTIVE) @map("account_status")
  onboardingStatus  CustomerOnboardingStatus  @default(MOBILE_VERIFIED) @map("onboarding_status")
  eligibilityStatus CustomerEligibilityStatus @default(NOT_CHECKED) @map("eligibility_status")

  eligibilityReason    String?   @map("eligibility_reason") @db.VarChar(500)
  eligibilityCheckedAt DateTime? @map("eligibility_checked_at") @db.DateTime(0)

  latestApplicationId BigInt? @map("latest_application_id") @db.UnsignedBigInt

  lastLoginAt    DateTime? @map("last_login_at") @db.DateTime(0)
  lastActivityAt DateTime? @map("last_activity_at") @db.DateTime(0)

  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(0)
  kycVerificationStatuses KycVerificationStatus[]
  plPaymentLinks          PlPaymentLink[]
  documents               PlCustomerDocument[]
  applications            PlApplication[]
  loans                   PlLoan[]

  @@index([email], map: "idx_customers_email")
  @@index([accountStatus], map: "idx_customers_account_status")
  @@index([onboardingStatus], map: "idx_customers_onboarding_status")
  @@index([eligibilityStatus], map: "idx_customers_eligibility_status")
  @@index([createdAt], map: "idx_customers_created_at")
  @@map("customers")
}

enum KycStatus {
  PENDING
  INITIATED
  VERIFIED
  FAILED
}

model KycVerificationStatus {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  customerId BigInt   @unique(map: "uk_kyc_verification_status_customer_id") @map("customerId") @db.UnsignedBigInt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  panStatus     KycStatus @default(PENDING) @map("panStatus")
  gstStatus     KycStatus @default(PENDING) @map("gstStatus")
  aadhaarStatus KycStatus @default(PENDING) @map("aadhaarStatus")
  bureauStatus  KycStatus @default(PENDING) @map("bureauStatus")
  mobileStatus  KycStatus @default(PENDING) @map("mobileStatus")
  emailStatus   KycStatus @default(PENDING) @map("emailStatus")

  mobileApiRequest  String? @map("mobileApiRequest") @db.LongText
  mobileApiResponse String? @map("mobileApiResponse") @db.LongText
  emailApiRequest   String? @map("emailApiRequest") @db.LongText
  emailApiResponse  String? @map("emailApiResponse") @db.LongText

  aadhaarTransactionId String?   @map("aadhaarTransactionId") @db.VarChar(255)
