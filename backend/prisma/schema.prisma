  aadhaarAddrLine2      String?   @map("aadhaar_addr_line2") @db.VarChar(500)
  aadhaarLandmark       String?   @map("aadhaar_landmark") @db.VarChar(200)
  aadhaarLocality       String?   @map("aadhaar_locality") @db.VarChar(200)
  aadhaarDistrict       String?   @map("aadhaar_district") @db.VarChar(100)
  aadhaarCity           String?   @map("aadhaar_city") @db.VarChar(100)
  aadhaarState          String?   @map("aadhaar_state") @db.VarChar(100)
  aadhaarCountry        String?   @default("India") @map("aadhaar_country") @db.VarChar(50)
  aadhaarPincode        String?   @map("aadhaar_pincode") @db.VarChar(6)
  aadhaarFormattedAddr  String?   @map("aadhaar_formatted_addr") @db.Text
  digilockerVerifiedAt  DateTime? @map("digilocker_verified_at") @db.DateTime(0)
