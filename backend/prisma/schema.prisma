  merchantTransactionId String  @unique(map: "uk_pl_loan_mandate_transaction") @map("merchant_transaction_id") @db.VarChar(40)
  providerMandateId     String? @unique(map: "uk_pl_loan_mandate_provider_id") @map("provider_mandate_id") @db.VarChar(255)

