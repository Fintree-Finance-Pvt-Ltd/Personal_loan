  decisionStatus           LenderIntegrationOperationStatus @default(NOT_STARTED)
  lastSyncedStage          LenderIntegrationStage?
  createIdempotencyKey     String                           @unique @db.VarChar(191)
  consentIdempotencyKey    String?                          @unique @db.VarChar(191)
  updateIdempotencyKey     String?                          @unique @db.VarChar(191)
