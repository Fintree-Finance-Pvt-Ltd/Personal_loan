  esignProviderRef   String?   @map("esign_provider_ref") @db.VarChar(255)
  esignDocumentTypes String?   @map("esign_document_types") @db.VarChar(500)
  esignInitiatedAt   DateTime? @map("esign_initiated_at") @db.DateTime(0)
  esignCompletedAt   DateTime? @map("esign_completed_at") @db.DateTime(0)

  electronicSignStatus        PlElectronicSignStatus? @map("electronic_sign_status")
  electronicSignReference     String?                 @map("electronic_sign_reference") @db.VarChar(120)
  electronicSignedAt          DateTime?               @map("electronic_signed_at") @db.DateTime(0)
  acceptedAgreementDocumentId BigInt?                 @map("accepted_agreement_document_id") @db.UnsignedBigInt

  // ── Disbursal ─────────────────────────────────────────────────────────
  disbursalStatus      String?   @map("disbursal_status") @db.VarChar(30)
  disbursalProviderRef String?   @map("disbursal_provider_ref") @db.VarChar(255)
  disbursalAmount      Decimal?  @map("disbursal_amount") @db.Decimal(15, 2)
  disbursalRequestedAt DateTime? @map("disbursal_requested_at") @db.DateTime(0)
  disbursalCompletedAt DateTime? @map("disbursal_completed_at") @db.DateTime(0)
  disbursalUtr         String?   @map("disbursal_utr") @db.VarChar(100)
  disbursalDate        DateTime? @map("disbursal_date") @db.Date
  firstRepaymentDate   DateTime? @map("first_repayment_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  auditEvents                PlLoanAuditEvent[]
  bankVerification           PlBankVerification?
  mandates                   PlLoanMandate[]
  electronicSignTransactions PlElectronicSignTransaction[]
  repaymentSchedules         PlRepaymentSchedule[]
  repayments                 PlRepayment[]
  allocations                PlRepaymentAllocation[]
  charges                    PlLoanCharge[]

  @@unique([applicationId], map: "uk_pl_loans_application_id")
  @@index([customerId], map: "idx_pl_loans_customer_id")
  @@index([applicationId], map: "idx_pl_loans_application_id")
  @@index([status], map: "idx_pl_loans_status")
  @@index([lenderCode], map: "idx_pl_loans_lender_code")
  @@map("pl_loans")
}

enum PlMandateProvider {
