  lastRequestHash          String?                          @db.Char(64)
  lastResponseStatus       String?                          @db.VarChar(80)
  lastAttemptAt            DateTime?
  lastSuccessAt            DateTime?
  lastErrorCode            String?                          @db.VarChar(100)
  lastErrorMessage         String?                          @db.VarChar(500)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  application            PlApplication            @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  lender                 Lender                   @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  lenderProduct          LenderProduct            @relation(fields: [lenderProductId], references: [id], onDelete: Restrict)
  productStrategyVersion LenderProductVersion     @relation(fields: [productStrategyVersionId], references: [id], onDelete: Restrict)
  integrationConfig      LenderIntegrationConfig  @relation(fields: [integrationConfigId], references: [id], onDelete: Restrict)
  documentTransfers      LenderDocumentTransfer[]

  @@index([lenderId, createStatus])
  @@index([adapterKey, adapterVersion])
  @@index([partnerApplicationId])
}

