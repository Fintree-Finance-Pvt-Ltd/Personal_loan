  providerSubStatus String?         @map("provider_sub_status") @db.VarChar(100)

  amount     Decimal @db.Decimal(15, 2)
  amountRule String  @default("MAX") @map("amount_rule") @db.VarChar(20)
  frequency  String  @default("monthly") @db.VarChar(30)

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  accountNumberMasked String? @map("account_number_masked") @db.VarChar(30)
  ifscMasked          String? @map("ifsc_masked") @db.VarChar(20)
  accountType         String? @map("account_type") @db.VarChar(20)
  accountHolderName   String? @map("account_holder_name") @db.VarChar(150)

  umrn                String? @db.VarChar(255)
  bankReferenceNumber String? @map("bank_reference_number") @db.VarChar(255)
  tpvValidationStatus String? @map("tpv_validation_status") @db.VarChar(50)

  authorizedAt        DateTime? @map("authorized_at") @db.DateTime(0)
  failedAt            DateTime? @map("failed_at") @db.DateTime(0)
  expiresAt           DateTime? @map("expires_at") @db.DateTime(0)
  lastStatusCheckedAt DateTime? @map("last_status_checked_at") @db.DateTime(0)

  providerRequestJson  String? @map("provider_request_json") @db.LongText
  providerResponseJson String? @map("provider_response_json") @db.LongText
  callbackResponseJson String? @map("callback_response_json") @db.LongText
  webhookResponseJson  String? @map("webhook_response_json") @db.LongText

  failureCode   String? @map("failure_code") @db.VarChar(100)
  failureReason String? @map("failure_reason") @db.VarChar(500)

  initiationCount Int @default(1) @map("initiation_count")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([loanId, status], map: "idx_pl_mandate_loan_status")
  @@index([customerId], map: "idx_pl_mandate_customer")
  @@index([lan], map: "idx_pl_mandate_lan")
  @@index([providerMandateId], map: "idx_pl_mandate_provider")
  @@map("pl_loan_mandates")
}

