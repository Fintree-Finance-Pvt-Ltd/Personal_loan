<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Borrower Agreement - {{application.loanAccountNumber}}</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 12mm 12mm 15mm 12mm;
    }

    :root {
      --page-width: 210mm;
      --page-height: 297mm;
      --ink: #111827;
      --border: #1f2937;
      --muted: #f3f4f6;
      --sign-blue: #1759b3;
      --sign-bg: #f4f7fd;
      --sign-red: #c01818;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #fff;
    }

    body {
      width: auto;
      min-height: 100%;
      font-family: "Times New Roman", Times, serif;
      font-size: 10pt;
      line-height: 1.34;
      color: var(--ink);
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      orphans: 3;
      widows: 3;
    }

    p {
      margin: 0 0 5px;
    }

    p.empty {
      height: 3mm;
      min-height: 0;
      margin: 0;
      font-size: 0;
      line-height: 0;
    }

    .text-center {
      text-align: center;
    }

    .text-right {
      text-align: right;
    }

    .text-justify {
      text-align: justify;
      text-justify: inter-word;
    }

    .section-title {
      margin: 5mm 0 4mm;
      text-align: center;
      font-size: 14pt;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: 0.15px;
      break-after: avoid-page;
      page-break-after: avoid;
    }

    .subsection-title {
      margin: 4mm 0 3mm;
      text-align: center;
      font-size: 12pt;
      line-height: 1.2;
      font-weight: 700;
      break-after: avoid-page;
      page-break-after: avoid;
    }

    .page-break {
      display: block;
      height: 0;
      break-before: page;
      page-break-before: always;
    }

    .avoid-break,
    .signature-area,
    .acceptance-stamp,
    .acceptance-certificate-summary {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .keep-with-next {
      break-after: avoid-page;
      page-break-after: avoid;
    }

    .data-table {
      width: 100%;
      margin: 3mm 0 4mm;
      border-collapse: collapse;
      border-spacing: 0;
      table-layout: fixed;
      font-size: 9pt;
      line-height: 1.28;
    }

    .data-table thead {
      display: table-header-group;
    }

    .data-table tbody {
      display: table-row-group;
    }

    .data-table tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .data-table th,
    .data-table td {
      border: 0.35mm solid var(--border);
      padding: 2.2mm 2.4mm;
      vertical-align: top;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .data-table th {
      background: var(--muted);
      text-align: center;
      font-weight: 700;
    }

    .data-table td:first-child:not([colspan]) {
      vertical-align: top;
    }

    .signature-area {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12mm;
      margin-top: 10mm;
      align-items: end;
    }

    .signature-box {
      min-height: 25mm;
    }

    .signature-line {
      border-top: 0.35mm solid #111;
      padding-top: 2mm;
      text-align: center;
    }

    .signature-placeholder {
      width: 100%;
      min-height: 20mm;
      margin: 0;
      border: 0;
      padding: 0;
    }

    .acceptance-wrapper {
      display: flex;
      justify-content: flex-end;
      width: 100%;
      margin-top: 8mm;
    }

    .acceptance-stamp {
      width: 88mm;
      min-height: 38mm;
      margin: 0;
      padding: 4mm 5mm;
      border: 0.7mm solid var(--sign-blue);
      background: var(--sign-bg);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 8.5pt;
      line-height: 1.35;
      color: #1f2f4f;
      overflow-wrap: anywhere;
    }

    .acceptance-title {
      margin-bottom: 2mm;
      color: var(--sign-blue);
      font-size: 11pt;
      line-height: 1.2;
      font-weight: 800;
      text-align: left;
      letter-spacing: 0.1px;
    }

    .acceptance-row {
      display: grid;
      grid-template-columns: 23mm 1fr;
      column-gap: 2mm;
      margin: 0.6mm 0;
    }

    .acceptance-label {
      font-weight: 700;
    }

    .acceptance-footer {
      margin-top: 4mm;
      color: var(--sign-red);
      font-weight: 700;
    }

    .certificate-page {
      break-before: page;
      page-break-before: always;
    }

    .certificate-grid {
      width: 100%;
      margin-top: 4mm;
      border-collapse: collapse;
      table-layout: fixed;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 8.7pt;
    }

    .certificate-grid td {
      border: 0.3mm solid #374151;
      padding: 2.2mm 2.5mm;
      vertical-align: top;
      overflow-wrap: anywhere;
    }

    .certificate-grid td:first-child {
      width: 40%;
      background: #f3f4f6;
      font-weight: 700;
    }

    .hash-value {
      font-family: "Courier New", monospace;
      font-size: 7.8pt;
      word-break: break-all;
    }

    .small {
      font-size: 8.3pt;
    }

    .no-print-break {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    @media screen {
      body {
        width: var(--page-width);
        min-height: var(--page-height);
        margin: 12mm auto;
        padding: 12mm;
        background: #fff;
        box-shadow: 0 0 0 1px #d1d5db, 0 8px 30px rgba(0, 0, 0, 0.08);
      }
    }

    @media print {

      html,
      body {
        width: auto;
        min-height: 0;
        background: #fff;
      }

      body {
        margin: 0;
        padding: 0;
        box-shadow: none;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      a {
        color: #111;
        text-decoration: none;
      }
    }
  </style>
</head>

<body>
  <!-- Template code: BORROWER_AGREEMENT_EN_V2_A4 | A4 portrait | OTP acceptance stamp on final execution section -->
  <p class="empty">&nbsp;</p>
  <p class="text-center section-title">SANCTION LETTER</p>
  <p class="empty">&nbsp;</p>
  <p class="">Dear {{borrower.fullName}},</p>
  <p class="empty">&nbsp;</p>
  <p class="">Subject: Unsecured Personal Loan from Fintree Finance Private Limited (Lender)</p>
  <p class="">With reference to your application dated {{application.applicationDateFormatted}}, for an unsecured
    personal loan, we have the pleasure of sanctioning you an amount of {{formatCurrency loan.sanctionedAmount}} subject
    to the following Terms and Conditions:</p>
  <p class="empty">&nbsp;</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>1</th>
        <th>Loan Amount</th>
        <th>{{formatCurrency loan.sanctionedAmount}}</th>
      </tr>
      <tr>
        <td>2</td>
        <td>Tenure of the Loan</td>
        <td>{{loan.tenureFormatted}}</td>
      </tr>
      <tr>
        <td>3</td>
        <td>Number of Instalments</td>
        <td>{{loan.numberOfInstallments}}</td>
      </tr>
      <tr>
        <td>4</td>
        <td>Interest Rate and *Method of Application thereof.</td>
        <td>*Reducing Balance annualised interest rate {{formatPercentage pricing.annualInterestRate}}</td>
      </tr>
    </tbody>
  </table>
  <p class="text-justify empty">&nbsp;</p>
  <p class="text-justify">*At Fintree Finance Private Limited (hereinafter referred to as ‘FFPL’/ lender’), the interest
    rate has been arrived at after taking into account broad parameters like customer profile, financials, sources of
    funds, risk profile of the customer, nature of lending, etc. and hence the rate of interest may differ across the
    borrowers. As of the effective date, the #Schedule of interest and the charges are as follows:</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>Interest on the Loan and method of application thereof.</th>
        <th>{{formatPercentage pricing.annualInterestRate}} per year from the date of disbursal until the date of
          repayment.<br></th>
      </tr>
      <tr>
        <td>Processing Fee</td>
        <td>{{formatPercentage pricing.processingFeeRate}} plus, applicable taxes</td>
      </tr>
      <tr>
        <td>Penal Charges</td>
        <td>One-time penal charges upto 10% + Applicable Taxes (GST/ Others)<br>Minimum Penal charges amount Rs. 100/- +
          Applicable Taxes (GST/ Others)<br>Maximum Penal charges amount Rs. 3000/- + Applicable Taxes (GST/ Others)
        </td>
      </tr>
      <tr>
        <td>Interest rate</td>
        <td>{{formatPercentage pricing.annualInterestRate}} per Annum</td>
      </tr>
      <tr>
        <td>Bounce Charges</td>
        <td>&nbsp;</td>
      </tr>
    </tbody>
  </table>
  <p class="">#The Fintree, may at its sole discretion, waive or reduce the charges as mentioned above, on a case to
    case basis.</p>
  <p class="empty">&nbsp;</p>
  <p class="">For any queries, you may write to us at wecare@fintreefinance.com .</p>
  <p class="empty">&nbsp;</p>
  <p class="">Look forward to serving you</p>
  <p class="empty">&nbsp;</p>
  <p class="">Kind Regards,</p>
  <div class="signature-area avoid-break">
    <div class="signature-box">
      {{#if authorizedSignatoryImage}}
      <img src="{{authorizedSignatoryImage}}" alt="Authorized Signatory"
        style="height: 42px; max-width: 170px; object-fit: contain; display: block; margin: 0 auto 4px;" />
      {{/if}}
      <div class="signature-line">Authorized Signatory</div>
    </div>
    <div class="signature-box">
      {{#if electronicAcceptance.completed}}
      <div class="acceptance-stamp">
        <div class="acceptance-title">{{electronicAcceptance.stampHeading}}</div>
        <div class="acceptance-row"><span
            class="acceptance-label">By:</span><span>{{electronicAcceptance.signerName}}</span></div>
        <div class="acceptance-row"><span
            class="acceptance-label">Date:</span><span>{{electronicAcceptance.acceptedAtFormatted}}</span></div>
        <div class="acceptance-row"><span
            class="acceptance-label">IP:</span><span>{{electronicAcceptance.ipAddress}}</span></div>
        {{#if electronicAcceptance.environmentLabel}}
        <div class="acceptance-row"><span
            class="acceptance-label">Env:</span><span>{{electronicAcceptance.environmentLabel}}</span></div>
        {{/if}}
        <div class="acceptance-row"><span
            class="acceptance-label">Ref:</span><span>{{electronicAcceptance.transactionReference}}</span></div>
        <div class="acceptance-footer">{{electronicAcceptance.stampFooterText}}</div>
      </div>
      {{else}}
      <div class="signature-line">Digital signature / electronic acceptance of the customer</div>
      {{/if}}
    </div>
  </div>
  <p class="empty">&nbsp;</p>
  <div class="page-break"></div>
  <p class="text-center section-title">KEY FACT STATEMENT</p>
  <p class="text-center">(Unsecured Personal Loan)</p>
  <p class="">Details of Lender and Borrower</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>Name of the Lender/ Regulated Entity (RE)</th>
        <th>Fintree Finance Private Limited</th>
      </tr>
      <tr>
        <td>Name of the Borrower</td>
        <td>{{borrower.fullName}}</td>
      </tr>
      <tr>
        <td>Address of the Borrower</td>
        <td>{{borrower.address.formatted}}</td>
      </tr>
      <tr>
        <td>Email ID &amp; Contact</td>
        <td>{{borrower.email}} / {{borrower.maskedMobile}}</td>
      </tr>
      <tr>
        <td>Bank Details of Borrower</td>
        <td>{{bank.bankName}}, A/c {{bank.maskedAccountNumber}}, IFSC {{bank.ifscCode}}</td>
      </tr>
    </tbody>
  </table>
  <p class="empty">&nbsp;</p>
  <div class="page-break"></div>
  <p class="subsection-title"> Annexure A</p>
  <p class="">Key Facts Statement</p>
  <p class="">Part 1 (Interest rate and fees/charges)</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>1</th>
        <th>Loan Proposal/Account No.</th>
        <th>{{application.loanAccountNumber}}</th>
        <th>Type of Loan</th>
        <th>Unsecured Personal Loan</th>
      </tr>
      <tr>
        <td>2</td>
        <td>Sanctioned Loan amount (in Rupees)</td>
        <td>{{formatCurrency loan.sanctionedAmount}}</td>
        <td>{{formatCurrency loan.sanctionedAmount}}</td>
        <td>{{formatCurrency loan.sanctionedAmount}}</td>
      </tr>
      <tr>
        <td>3</td>
        <td>Disbursal Schedule<br>(i) Disbursement in stages<br>(ii) If it is stage wise, mention the clause of loan
          agreement having the relevant details</td>
        <td><br>100% Upfront<br><br>NA</td>
        <td><br>100% Upfront<br><br>NA</td>
        <td><br>100% Upfront<br><br>NA</td>
      </tr>
      <tr>
        <td>4</td>
        <td>Loan Term (Days/Months/Year)</td>
        <td>{{loan.tenureFormatted}}</td>
        <td>{{loan.tenureFormatted}}</td>
        <td>{{loan.tenureFormatted}}</td>
      </tr>
      <tr>
        <td>5</td>
        <td>Installment Details</td>
        <td>Installment Details</td>
        <td>Installment Details</td>
        <td>Installment Details</td>
      </tr>
      <tr>
        <td>Type of Installments</td>
        <td>No. of EPIs</td>
        <td>EPI (Rs)</td>
        <td>Commencement of repayment, post sanction</td>
        <td>Commencement of repayment, post sanction</td>
      </tr>
      <tr>
        <td>Monthly</td>
        <td>Bullet Payment (1)</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
      </tr>
    </tbody>
  </table>
  <p class="empty">&nbsp;</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>6</th>
        <th>Interest rate (%) and<br>type (fixed or floating or hybrid)</th>
        <th>Interest rate (%) and<br>type (fixed or floating or hybrid)</th>
        <th>{{formatPercentage pricing.annualInterestRate}} per Annum<br>Fixed<br></th>
        <th>{{formatPercentage pricing.annualInterestRate}} per Annum<br>Fixed<br></th>
        <th>{{formatPercentage pricing.annualInterestRate}} per Annum<br>Fixed<br></th>
        <th>{{formatPercentage pricing.annualInterestRate}} per Annum<br>Fixed<br></th>
        <th>{{formatPercentage pricing.annualInterestRate}} per Annum<br>Fixed<br></th>
      </tr>
      <tr>
        <td>Reference Benchmark</td>
        <td>Reference Benchmark (%) (B)</td>
        <td>Spread (%) (S)<br></td>
        <td>Final rate (%) R = (B) + (s)</td>
        <td>Reset periodicity (Months)</td>
        <td>Reset periodicity (Months)</td>
        <td>Impact of change in the reference benchmark (for 25 bps change in ‘R’, change in:)</td>
        <td>Impact of change in the reference benchmark (for 25 bps change in ‘R’, change in:)</td>
      </tr>
      <tr>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>B</td>
        <td>S</td>
        <td>EPI (Rs)</td>
        <td>No. of EPIs</td>
      </tr>
      <tr>
        <td>NA</td>
        <td>NA</td>
        <td>NA</td>
        <td>NA</td>
        <td>NA</td>
        <td>NA</td>
        <td>NA</td>
        <td>NA</td>
      </tr>
      <tr>
        <td>8</td>
        <td>Fee/ Charges</td>
        <td>Fee/ Charges</td>
        <td>Fee/ Charges</td>
        <td>Fee/ Charges</td>
        <td>Fee/ Charges</td>
        <td>Fee/ Charges</td>
        <td>Fee/ Charges</td>
      </tr>
      <tr>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>Payable to the RE (A)</td>
        <td>Payable to the RE (A)</td>
        <td>Payable to a third party through RE (B)</td>
        <td>Payable to a third party through RE (B)</td>
        <td>Payable to a third party through RE (B)</td>
        <td>Payable to a third party through RE (B)</td>
      </tr>
      <tr>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>One-time/ Recurring</td>
        <td>Amount (in Rs) or<br>Percentage (%) as<br>applicable</td>
        <td>One-time/ Recurring</td>
        <td>One-time/ Recurring</td>
        <td>Amount (in Rs) or<br>Percentage (%)as<br>applicable</td>
        <td>Amount (in Rs) or<br>Percentage (%)as<br>applicable</td>
      </tr>
      <tr>
        <td>(i)</td>
        <td>Processing fees</td>
        <td>One Time</td>
        <td>{{#if
          pricing.processingFeeAmountFormatted}}{{pricing.processingFeeAmountFormatted}}{{else}}{{formatPercentage
          pricing.processingFeeRate}}{{/if}}</td>
        <td>NIL</td>
        <td>NIL</td>
        <td>NIL</td>
        <td>NIL</td>
      </tr>
      <tr>
        <td>9</td>
        <td>Annual Percentage Rate (APR) (%)</td>
        <td>Annual Percentage Rate (APR) (%)</td>
        <td>Annual Percentage Rate (APR) (%)</td>
        <td>Annual Percentage Rate (APR) (%)</td>
        <td>Annual Percentage Rate (APR) (%)</td>
        <td>{{formatPercentage pricing.apr}} p.a. which shall comprise of;<br>1. Rate of Interest: {{formatPercentage
          pricing.annualInterestRate}} per annum/ year;<br>2. Processing fee: {{formatCurrency
          pricing.processingFeeAmount}} (one-time, non-refundable fee levied for processing and grant of loan, Taxes and
          Levies as applicable);</td>
        <td>{{formatPercentage pricing.apr}} p.a. which shall comprise of;<br>1. Rate of Interest: {{formatPercentage
          pricing.annualInterestRate}} per annum/ year;<br>2. Processing fee: {{formatCurrency
          pricing.processingFeeAmount}} (one-time, non-refundable fee levied for processing and grant of loan, Taxes and
          Levies as applicable);</td>
      </tr>
      <tr>
        <td>10</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
        <td>Details of Contingent Charges (in Rs or %, as applicable)</td>
      </tr>
    </tbody>
  </table>
  <table class="data-table">
    <tbody>
      <tr>
        <th>(i)</th>
        <th>Penal charges, if any, in case of delayed payment</th>
        <th>One-time penal charges upto 10%+ Applicable Taxes (GST/ Others)<br>Minimum Penal charges amount Rs. 100/- +
          Applicable Taxes (GST/ Others)<br>Maximum Penal charges amount Rs. 3000/- + Applicable Taxes (GST/ Others)
        </th>
      </tr>
      <tr>
        <td>(ii)</td>
        <td>Other penal charges, if any (Bounce Charges)</td>
        <td>&nbsp;</td>
      </tr>
      <tr>
        <td>(iii)</td>
        <td>Foreclosure charges, if applicable</td>
        <td>NA</td>
      </tr>
      <tr>
        <td>(iv)</td>
        <td>Any other charges (please specify)</td>
        <td>NA</td>
      </tr>
    </tbody>
  </table>
  <p class="empty">&nbsp;</p>
  <p class="">Part 2 (Other qualitative information)</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>1</th>
        <th>Clause of Loan agreement engagement of recovery agents relating to engagement of recovery agents</th>
        <th>Clause 27</th>
      </tr>
      <tr>
        <td>2</td>
        <td>Clause of Loan agreement which details grievance redressal mechanism</td>
        <td>Clause 26</td>
      </tr>
      <tr>
        <td>3</td>
        <td>Phone number and email id of the Nodal grievance redressal officer</td>
        <td>Contact: 18002678111<br>wecare@fintreefinance.com .</td>
      </tr>
      <tr>
        <td>4</td>
        <td>Whether the loan is, or in future maybe, subject to transfer to other REs or securitisation (Yes/No)</td>
        <td>No</td>
      </tr>
      <tr>
        <td>5</td>
        <td>In case of lending under collaborative lending arrangements (e.g., co-lending/ outsourcing), following
          additional details may be furnished:</td>
        <td>NA</td>
      </tr>
      <tr>
        <td>6</td>
        <td>Name of the originating RE, along with its funding proportion</td>
        <td>Blended rate of interest<br></td>
      </tr>
      <tr>
        <td>7</td>
        <td>In case of digital loans, following specific disclosures may be furnished:</td>
        <td>In case of digital loans, following specific disclosures may be furnished:</td>
      </tr>
      <tr>
        <td>(i)</td>
        <td>Cooling off/look-up period, in terms of RE’s board approved policy, during which borrower shall not be
          charged any penalty on prepayment of loan.</td>
        <td>3 Days</td>
      </tr>
    </tbody>
  </table>
  <div class="signature-area avoid-break">
    <div class="signature-box">
      {{#if authorizedSignatoryImage}}
      <img src="{{authorizedSignatoryImage}}" alt="Authorized Signatory"
        style="height: 42px; max-width: 170px; object-fit: contain; display: block; margin: 0 auto 4px;" />
      {{/if}}
      <div class="signature-line">Authorized Signatory</div>
    </div>
    <div class="signature-box">
      {{#if electronicAcceptance.completed}}
      <div class="acceptance-stamp">
        <div class="acceptance-title">{{electronicAcceptance.stampHeading}}</div>
        <div class="acceptance-row"><span
            class="acceptance-label">By:</span><span>{{electronicAcceptance.signerName}}</span></div>
        <div class="acceptance-row"><span
            class="acceptance-label">Date:</span><span>{{electronicAcceptance.acceptedAtFormatted}}</span></div>
        <div class="acceptance-row"><span
            class="acceptance-label">IP:</span><span>{{electronicAcceptance.ipAddress}}</span></div>
        {{#if electronicAcceptance.environmentLabel}}
        <div class="acceptance-row"><span
            class="acceptance-label">Env:</span><span>{{electronicAcceptance.environmentLabel}}</span></div>
        {{/if}}
        <div class="acceptance-row"><span
            class="acceptance-label">Ref:</span><span>{{electronicAcceptance.transactionReference}}</span></div>
        <div class="acceptance-footer">{{electronicAcceptance.stampFooterText}}</div>
      </div>
      {{else}}
      <div class="signature-line">Digital signature / electronic acceptance of the customer</div>
      {{/if}}
    </div>
  </div>
  <p class="empty">&nbsp;</p>
  <div class="page-break"></div>
  <p class="subsection-title">Annexure B</p>
  <p class="empty">&nbsp;</p>
  <table class="data-table">
    <tbody>
      <tr>
        <th>Illustration for computation of APR for Retail and MSME loans</th>
        <th>Illustration for computation of APR for Retail and MSME loans</th>
        <th>Illustration for computation of APR for Retail and MSME loans</th>
      </tr>
      <tr>
        <td>Sr. No.<br></td>
        <td>Parameter</td>
        <td>Details</td>
      </tr>
      <tr>
        <td>1</td>
        <td>Sanctioned Loan amount (in Rupees) - S.No 2 of the KFS Annexure-A</td>
        <td>{{formatCurrency loan.sanctionedAmount}}</td>
      </tr>
      <tr>
        <td>2</td>
        <td>Loan Term (in years/ months/ days) - S.No 4 of the KFS Annexure-A</td>
        <td>{{loan.tenureFormatted}}</td>
      </tr>
      <tr>
        <td>a)</td>
        <td>No. of instalments for payment of principal, in case of non- equated periodic loans</td>
        <td>1</td>
      </tr>
      <tr>
        <td>b)</td>
        <td>Type of EPI Amount of each EPI (in Rupees) and nos. of EPIs (e.g., no. of EMIs in case of monthly
          instalments) (Sr. No. 5 of the KFS Annexure-A)</td>
        <td>&nbsp;</td>
      </tr>
      <tr>
        <td>c)</td>
        <td>No. of instalments for payment of capitalised interest, if any</td>
        <td>NA</td>
      </tr>
      <tr>
        <td>d)</td>
        <td>Commencement of repayments, post sanction (Sr. No. 5 of the KFS Annexure A)</td>
        <td>&nbsp;</td>
      </tr>
      <tr>
        <td>3</td>
        <td>Interest rate type (fixed or floating or hybrid) (Sr. No. 6 of the KFS Annexure A)</td>
        <td>Fixed</td>
      </tr>
      <tr>
        <td>4</td>
        <td>Rate of Interest (Sr. No. 6 of the KFS Annexure A)</td>
        <td>{{formatPercentage pricing.annualInterestRate}} per annum/year</td>
      </tr>
      <tr>
        <td>5</td>
        <td>Total Interest Amount to be charged during the entire tenure of the loan as per the rate prevailing on
          sanction date (in Rupees)</td>
        <td>{{formatCurrency loan.totalInterestAmount}}</td>
      </tr>
      <tr>
        <td>6</td>
        <td>Fee/ Charges payable (in Rupees)</td>
        <td>&nbsp;</td>
      </tr>
      <tr>
        <td>A</td>
        <td>Payable to the RE (Sr. No.8A of the KFS Annexure-A)</td>
        <td>{{formatCurrency pricing.processingFeeAmount}}</td>
      </tr>
      <tr>
        <td>B</td>
        <td>Payable to third-party routed through RE (Sr. No.8B of the KFS Annexure-A)</td>
        <td>NA</td>
      </tr>
      <tr>
        <td>7</td>
        <td>Net disbursed amount (1-6) (in Rupees)</td>
        <td>{{formatCurrency loan.netDisbursedAmount}}</td>
      </tr>
      <tr>
        <td>8</td>
        <td>Total amount to be paid by the borrower (sum of 1 and 5) (in Rupees)</td>
        <td>{{formatCurrency loan.totalRepaymentAmount}}</td>
      </tr>
      <tr>
        <td>9</td>
        <td>Annual Percentage rate- Effective annualized interest rate (in %) (Sr. No.9 of the KFS Annexure-A)</td>
        <td>{{formatPercentage pricing.apr}}</td>
      </tr>
      <tr>
        <td>10</td>
        <td>Schedule of disbursement as per terms and conditions</td>
        <td>Annexure C</td>
      </tr>
      <tr>
        <td>11</td>
        <td>Due date of payment of instalment and interest (dd-mm-yyyy)</td>
        <td>&nbsp;</td>
      </tr>
    </tbody>
  </table>
  <p class="">
    Please Note : Actual Repayment Date may vary depending on the date of disbursement</p>
