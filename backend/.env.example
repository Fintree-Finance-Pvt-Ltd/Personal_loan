# Backend configuration belongs only in backend/.env.
NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=mysql://username:password@localhost:3306/personal_loan_platform

FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

# Generate independent random values of at least 32 characters (64+ recommended).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=10m
JWT_ISSUER=personal-loan-platform
JWT_AUDIENCE=personal-loan-admin

CUSTOMER_JWT_ACCESS_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=

REFRESH_TOKEN_PEPPER=
REFRESH_SESSION_HOURS=8
REFRESH_IDLE_TIMEOUT_MINUTES=30

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

COOKIE_NAME=plp_admin_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

SECURITY_HMAC_KEY=
AUDIT_INTEGRITY_KEY=

SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
