# Backend configuration belongs only in backend/.env.
NODE_ENV=development
PORT=3005
LENDER_INTEGRATION_WORKER_ENABLED=true
LENDER_INTEGRATION_WORKER_POLL_MS=5000
LENDER_INTEGRATION_WORKER_LOCK_SECONDS=300
LENDER_DATA_SHARING_CONSENT_VERSION=1.0
LENDER_DATA_SHARING_CONSENT_REFERENCE=CUSTOMER_LENDER_DATA_SHARING
API_PREFIX=api

DATABASE_URL=mysql://username:password@localhost:3306/personal_loan_platform

FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

# Generate independent random values of at least 32 characters (64+ recommended).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=10m
JWT_ISSUER=personal-loan-platform
JWT_AUDIENCE=personal-loan-admin

CUSTOMER_JWT_ACCESS_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=

REFRESH_TOKEN_PEPPER=
REFRESH_SESSION_HOURS=8
REFRESH_IDLE_TIMEOUT_MINUTES=30
# Customer sessions have no idle timeout, only this absolute cap (see
# environment.ts for why) — a fresh OTP login is required at least this often.
CUSTOMER_REFRESH_SESSION_DAYS=30

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

COOKIE_NAME=plp_admin_refresh
CUSTOMER_COOKIE_NAME=plp_customer_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

SECURITY_HMAC_KEY=
AUDIT_INTEGRITY_KEY=
# Signs short-lived /uploads document URLs (see document-url-signer.helper.ts) —
# generate an independent random value, do not reuse SECURITY_HMAC_KEY.
DOCUMENT_URL_SIGNING_KEY=

# AES-256-GCM key + HMAC fingerprint key for encrypting stored bank account numbers —
# both required, no fallback. Generate independent strong random values.
BANK_ACCOUNT_ENCRYPTION_KEY=
BANK_ACCOUNT_HMAC_KEY=

SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
LENDER_INTEGRATION_ALLOWED_HOSTS=
FINTREE_API_BEARER_TOKEN=
FINTREE_API_HMAC_SECRET=

# Unaport FIU Account Aggregator Web SDK Integration
UNAPORT_ENVIRONMENT=sandbox
UNAPORT_BASE_URL=https://common.sandbox.unaport.com/api/v1
UNAPORT_SDK_URL=https://sdk.sandbox.unaport.com/view
UNAPORT_EMAIL=
UNAPORT_PASSWORD=
UNAPORT_PRODUCT_ID=529684db-7241-44d7-95a3-fdc4ee9f8c11
UNAPORT_FIU_ID=UNACORES-FIU-UAT
UNAPORT_FI_TYPE=Deposits
UNAPORT_HTTP_TIMEOUT_MS=15000

# Personal Loan Account Aggregator Native Webhook & Consent Endpoints
UNAPORT_AA_WEBHOOK_URL=https://pl-fintree-uat.fintreelms.com/api/aa/webhook
UNAPORT_AA_CONSENT_WEBHOOK_URL=https://pl-fintree-uat.fintreelms.com/api/aa/consent
UNAPORT_AA_DATA_WEBHOOK_URL=https://pl-fintree-uat.fintreelms.com/api/aa/data

# Easebuzz Autocollect Cron Collection & Reconciliation
EASEBUZZ_AUTOCOLLECT_BASE_URL=https://api.easebuzz.in/autocollect
EASEBUZZ_MERCHANT_KEY=
EASEBUZZ_SALT=
EASEBUZZ_SUB_MERCHANT_ID=
EASEBUZZ_PRESENTMENT_FETCH_BALANCE=false
EASEBUZZ_PRESENTMENT_FORCE=false
EASEBUZZ_COLLECTION_CRON_ENABLED=true
EASEBUZZ_RECONCILIATION_CRON_ENABLED=true
EASEBUZZ_TIMEZONE=Asia/Kolkata
EASEBUZZ_MAX_DEBIT_ATTEMPTS=3

